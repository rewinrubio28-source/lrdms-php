# Copy this file to .env for local XAMPP development and fill in real
# values. .env is already git-ignored — never commit it.
#
# In production (HostForge), do NOT upload a .env file — instead, enter
# these same keys and values directly in the app's
# Environment Variables tab. The app reads getenv() either way.

# --- Database -----------------------------------------------------------
DB_HOST=localhost
DB_NAME=lrdms_db
DB_USER=root
DB_PASS=

# --- SMTP (password reset / 2FA emails) ---------------------------------
# For Gmail: use an App Password, not your normal account password.
# Google Account > Security > App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=LRDMS System

# --- App base URL (used to build links in emails) ------------------------
# Local:      http://localhost/lrdms-php
# Production: https://records.manilalegislativeservices.com
BASE_URL=http://localhost/lrdms-php

# --- Shared secret for System 1 / System 2 integration endpoints --------
# (api/upload_document.php, api/search.php). Generate a long random
# value for production, e.g.: php -r "echo bin2hex(random_bytes(32));"
API_SHARED_KEY=change-this-to-a-long-random-string

# --- File storage (S3-compatible: Cloudflare R2, Backblaze B2, Supabase...) ---
# HostForge wipes the container's disk on every deploy, so uploaded files must
# live outside it. Leave these blank for local XAMPP (files then go to uploads/).
# In production, set all of them in HostForge's Environment Variables tab.
# S3_PUBLIC_URL is the public base URL of the bucket, without a trailing slash.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_REGION=auto
